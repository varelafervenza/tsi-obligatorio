# Node / frontend
node_modules/
dist/
cliente-gestor/src-tauri/target/

# Python / backend
__pycache__/
*.pyc
venv/
# Copias locales con secretos (nunca versionar)
.env
*.env
infra/.env
infra/control-central.env

# Plantillas para copiar y editar (SÍ van al repo)
!.env.example
!*.env.example
!**/*.env.example

# Secretos y bóvedas de prueba
*.vault
keys/

# Logs SIEM generados en runtime (el directorio sí se versiona con .gitkeep)
infra/logs/*.jsonl
infra/logs/*.log

# Evidencias grandes (videos) opcionalmente fuera de git si se usa almacenamiento externo
# docs/evidencias/*.mp4
