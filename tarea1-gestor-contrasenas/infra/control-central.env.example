# Plantilla versionada. Copiar y editar la copia (no este archivo):
#   copy control-central.env.example control-central.env
#
# Sin contraseñas reales. SMTP_PASSWORD vacío = Mailpit sin auth.

DATABASE_URL=postgresql://gestor:changeme@postgres:5432/control_central
JWT_PUBLIC_KEYS_DIR=/app/keys/agentes
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@correo.local
SMTP_TO=rsi@correo.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
HASH_ALGORITHM=argon2id
SIEM_LOG_PATH=/var/log/control-central/audit-events.jsonl
